rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Role verification: check admin document or bootstrapper email
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'faruk017@gmail.com'
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admins registry
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // User profiles & settings (PII protected)
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Products catalog
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Orders
    match /orders/{orderId} {
      allow get: if isAdmin() || (isSignedIn() && existing().customerId == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow create: if isSignedIn() && incoming().customerId == request.auth.uid;
      allow update: if isAdmin() || (
        isSignedIn() && 
        existing().customerId == request.auth.uid &&
        incoming().diff(existing()).affectedKeys().hasOnly(['remarks', 'customerNote', 'orderStatus'])
      );
      allow delete: if isAdmin();
    }

    // Inventory transactions & stock ledger
    match /inventory_transactions/{txId} {
      allow read, write: if isAdmin();
    }

    // Suppliers directory
    match /suppliers/{supplierId} {
      allow read, write: if isAdmin();
    }

    // Expenses & financial records
    match /expenses/{expenseId} {
      allow read, write: if isAdmin();
    }

    // Coupons
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Notifications
    match /notifications/{notifId} {
      allow read, write: if isSignedIn();
    }

    // Audit logs for compliance
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
  }
}
