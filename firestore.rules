rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global safety net: default-deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened global primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admin verification: trusted admins registry OR verified bootstrapper email
    function isAdmin() {
      return isVerifiedUser() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'faruk017@gmail.com'
      );
    }

    // Seller or Admin verification
    function isSellerOrAdmin() {
      return isAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'seller'
      );
    }

    // 3. Entity Validation Blueprints
    function isValidUserCreate(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'phoneNumber', 'shopName', 'role', 'mfaEnabled', 'mfaMethod', 'addresses', 'savedWishlist', 'collectedVouchers', 'createdAt']) &&
        data.uid == userId &&
        data.email is string && data.email.size() <= 200 &&
        data.role in ['customer', 'seller', 'admin', 'superadmin', 'product_manager', 'inventory_manager', 'order_manager', 'accountant'] &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 250000));
    }

    function isValidUserUpdate(data) {
      return data.uid is string && data.uid.size() <= 128 &&
        data.email is string && data.email.size() <= 200 &&
        data.role in ['customer', 'seller', 'admin', 'superadmin', 'product_manager', 'inventory_manager', 'order_manager', 'accountant'] &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 250000));
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['id', 'name', 'sku', 'category', 'regularPrice', 'discountedPrice', 'status', 'images', 'variants']) &&
        data.id is string && data.id.size() <= 128 &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 200 &&
        data.sku is string && data.sku.size() >= 2 && data.sku.size() <= 100 &&
        data.category is string && data.category.size() <= 80 &&
        data.regularPrice is number && data.regularPrice >= 0 &&
        data.discountedPrice is number && data.discountedPrice >= 0 &&
        data.status in ['active', 'draft', 'archived'] &&
        data.images is list && data.images.size() >= 1 && data.images.size() <= 12 &&
        data.variants is list && data.variants.size() >= 1 && data.variants.size() <= 50;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['id', 'orderNumber', 'customerId', 'customerName', 'contactNumber', 'items', 'grandTotal', 'paymentMethod', 'orderStatus']) &&
        data.id is string && data.id.size() <= 128 &&
        data.orderNumber is string && data.orderNumber.size() <= 64 &&
        data.customerId is string && data.customerId.size() <= 128 &&
        data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 120 &&
        data.contactNumber is string && data.contactNumber.size() <= 30 &&
        data.items is list && data.items.size() >= 1 && data.items.size() <= 50 &&
        data.grandTotal is number && data.grandTotal >= 0 &&
        data.orderStatus in ['pending_payment', 'paid', 'confirmed', 'processing', 'packed', 'shipped', 'delivered', 'cancelled', 'returned', 'refunded'];
    }

    function isValidBid(data) {
      return data.keys().hasAll(['id', 'productId', 'bidAmount', 'quantity', 'customerId', 'status', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.productId is string && data.productId.size() <= 128 &&
        data.bidAmount is number && data.bidAmount > 0 &&
        data.quantity is number && data.quantity >= 1 &&
        data.customerId is string && data.customerId.size() <= 128 &&
        data.status in ['pending', 'accepted', 'countered', 'declined'] &&
        data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidCoupon(data) {
      return data.keys().hasAll(['id', 'code', 'discountType', 'discountValue', 'minOrderAmount', 'isActive']) &&
        data.id is string && data.id.size() <= 128 &&
        data.code is string && data.code.size() >= 2 && data.code.size() <= 40 &&
        data.discountType in ['percentage', 'fixed'] &&
        data.discountValue is number && data.discountValue > 0 &&
        data.minOrderAmount is number && data.minOrderAmount >= 0 &&
        data.isActive is bool;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['id', 'action', 'entity', 'timestamp']) &&
        data.id is string && data.id.size() <= 128 &&
        data.action is string && data.action.size() <= 80 &&
        data.entity is string && data.entity.size() <= 80 &&
        data.timestamp is string && data.timestamp.size() <= 64;
    }

    // 4. Collection Rules

    // Admins registry
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isValidId(adminId) && isAdmin();
    }

    // User profiles & PII protection (no privilege escalation)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isVerifiedUser() && isOwner(userId) && isValidUserCreate(incoming(), userId) && (
        isAdmin() || incoming().role == 'customer'
      );
      allow update: if isValidId(userId) && isVerifiedUser() && isValidUserUpdate(incoming()) && (
        isAdmin() || (
          isOwner(userId) &&
          incoming().uid == existing().uid &&
          incoming().role == existing().role &&
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'phoneNumber', 'shopName', 'mfaEnabled', 'mfaMethod', 'addresses', 'savedWishlist', 'collectedVouchers'])
        )
      );
      allow delete: if isValidId(userId) && isAdmin();
    }

    // Products catalog (public read, admin/seller write with validation)
    match /products/{productId} {
      allow get: if isValidId(productId);
      allow list: if true;
      allow create, update: if isValidId(productId) && isSellerOrAdmin() && isValidProduct(incoming());
      allow delete: if isValidId(productId) && isAdmin();
    }

    // Orders (strict customer isolation & status gate)
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && (isAdmin() || (isSignedIn() && existing().customerId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow create: if isValidId(orderId) && isVerifiedUser() && isValidOrder(incoming()) && incoming().customerId == request.auth.uid;
      allow update: if isValidId(orderId) && isVerifiedUser() && isValidOrder(incoming()) && (
        isAdmin() || (
          existing().customerId == request.auth.uid &&
          existing().orderStatus in ['pending_payment', 'paid', 'confirmed'] &&
          incoming().diff(existing()).affectedKeys().hasOnly(['remarks', 'orderStatus', 'statusHistory']) &&
          incoming().orderStatus == 'cancelled'
        )
      );
      allow delete: if isValidId(orderId) && isAdmin();
    }

    // Product Price Bids
    match /bids/{bidId} {
      allow get: if isValidId(bidId) && (isAdmin() || (isSignedIn() && existing().customerId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow create: if isValidId(bidId) && isVerifiedUser() && isValidBid(incoming()) && incoming().customerId == request.auth.uid && incoming().status == 'pending';
      allow update: if isValidId(bidId) && isSellerOrAdmin() && isValidBid(incoming());
      allow delete: if isValidId(bidId) && isAdmin();
    }

    // Vouchers / Coupons
    match /coupons/{couponId} {
      allow get: if isValidId(couponId);
      allow list: if true;
      allow create, update, delete: if isValidId(couponId) && isAdmin() && (request.method == 'delete' || isValidCoupon(incoming()));
    }

    // Inventory transactions & stock ledger (admin only)
    match /inventory_transactions/{txId} {
      allow get: if isValidId(txId) && isAdmin();
      allow list, create, update, delete: if isAdmin();
    }

    // Suppliers directory (admin only)
    match /suppliers/{supplierId} {
      allow get: if isValidId(supplierId) && isAdmin();
      allow list, create, update, delete: if isAdmin();
    }

    // Expenses & financial records (admin only)
    match /expenses/{expenseId} {
      allow get: if isValidId(expenseId) && isAdmin();
      allow list, create, update, delete: if isAdmin();
    }

    // Notifications (scoped to admin or recipient)
    match /notifications/{notifId} {
      allow get: if isValidId(notifId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(notifId) && isVerifiedUser();
      allow update: if isValidId(notifId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
      allow delete: if isAdmin();
    }

    // Audit logs (immutable append-only)
    match /audit_logs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(logId) && isVerifiedUser() && isValidAuditLog(incoming());
      allow update, delete: if false;
    }
  }
}
